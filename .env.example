# For development: serves from static/cards.json
PUBLIC_CARDS_URL=/cards.json

# For production: set to raw GitHub URL of your data repo
# PUBLIC_CARDS_URL=https://raw.githubusercontent.com/YOUR_USERNAME/greek-cards-data/main/cards.json

# Cloudflare Worker URL for push notifications
PUBLIC_PUSH_WORKER_URL=https://greek-push-worker.ollemesh.workers.dev
