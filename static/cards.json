    { "id": "c005", "front": "Αυτό", "back": "оно / это", "transliteration": "afto", "category": "αντωνυμίες" },
    { "id": "c006", "front": "Εμείς", "back": "мы", "transliteration": "emis", "category": "αντωνυμίες" },
    { "id": "c007", "front": "Εσείς", "back": "вы", "transliteration": "esis", "category": "αντωνυμίες" },
    { "id": "c008", "front": "Αυτοί", "back": "они (м.р. / смешанная группа)", "transliteration": "afti", "category": "αντωνυμίες" },
    { "id": "c009", "front": "Αυτές", "back": "они (ж.р.)", "transliteration": "aftes", "category": "αντωνυμίες" },
    { "id": "c010", "front": "Αυτά", "back": "они (ср.р.) / эти вещи", "transliteration": "afta", "category": "αντωνυμίες" },

    { "id": "c011", "front": "ο → τον → στον", "back": "мужской артикль:\nο (кто/что) → τον (вижу кого) → στον (куда/где)\nπρ.: ο γιατρός → τον γιατρό → στον γιατρό", "transliteration": "o → ton → ston", "category": "άρθρα" },
    { "id": "c012", "front": "η → την → στην", "back": "женский артикль:\nη (кто/что) → την (вижу кого) → στην (куда/где)\nπρ.: η δασκάλα → την δασκάλα → στην δασκάλα", "transliteration": "i → tin → stin", "category": "άρθρα" },
    { "id": "c013", "front": "το → το → στο", "back": "средний артикль:\nτο (кто/что) → το (вижу что, не меняется!) → στο (куда/где)\nπρ.: το σπίτι → το σπίτι → στο σπίτι", "transliteration": "to → to → sto", "category": "άρθρα" },

    { "id": "c014", "front": "Ο Νίκος είναι γιατρός.", "back": "Никос — врач.\n[ο — им.пад. м.р.]", "transliteration": "o nikos ine yatros", "category": "άρθρα" },
    { "id": "c015", "front": "Βλέπω τον γιατρό.", "back": "Я вижу врача.\n[τον — вин.пад. м.р.]", "transliteration": "vlepo ton yatro", "category": "άρθρα" },
    { "id": "c016", "front": "Πάω στον γιατρό.", "back": "Я иду к врачу.\n[στον = σε + τον]", "transliteration": "pao ston yatro", "category": "άρθρα" },
    { "id": "c017", "front": "Η Μαρία είναι δασκάλα.", "back": "Мария — учительница.\n[η — им.пад. ж.р.]", "transliteration": "i maria ine dhaskala", "category": "άρθρα" },
    { "id": "c018", "front": "Βλέπω την δασκάλα.", "back": "Я вижу учительницу.\n[την — вин.пад. ж.р.]", "transliteration": "vlepo tin dhaskala", "category": "άρθρα" },
    { "id": "c019", "front": "Πάω στην δουλειά.", "back": "Я иду на работу.\n[στην — ж.р., δουλειά = работа]", "transliteration": "pao stin dhulia", "category": "άρθρα" },
    { "id": "c020", "front": "Το σπίτι είναι μεγάλο.", "back": "Дом большой.\n[το — им.пад. ср.р.]", "transliteration": "to spiti ine megalo", "category": "άρθρα" },
    { "id": "c021", "front": "Μένω στο σπίτι.", "back": "Я остаюсь дома.\n[στο = σε + το]", "transliteration": "meno sto spiti", "category": "άρθρα" },
    { "id": "c022", "front": "Πάω στο καφέ.", "back": "Я иду в кафе.\n[στο — ср.р.]", "transliteration": "pao sto kafe", "category": "άρθρα" },

    { "id": "c023", "front": "ο γιατρός / η γιατρός", "back": "врач (м.) / врач (ж.)\n— форма одна, меняется только артикль!", "transliteration": "o yatros / i yatros", "category": "επαγγέλματα" },
    { "id": "c024", "front": "ο δάσκαλος / η δασκάλα", "back": "учитель / учительница", "transliteration": "o dhaskalos / i dhaskala", "category": "επαγγέλματα" },
    { "id": "c025", "front": "ο καθηγητής / η καθηγήτρια", "back": "преподаватель / преподавательница", "transliteration": "o kathiyitis / i kathiyitria", "category": "επαγγέλματα" },
    { "id": "c026", "front": "ο φοιτητής / η φοιτήτρια", "back": "студент / студентка", "transliteration": "o fotitis / i fotitria", "category": "επαγγέλματα" },
    { "id": "c027", "front": "ο σερβιτόρος / η σερβιτόρα", "back": "официант / официантка", "transliteration": "o servitoros / i servitora", "category": "επαγγέλματα" },
    { "id": "c028", "front": "ο νοσοκόμος / η νοσοκόμα", "back": "медбрат / медсестра", "transliteration": "o nosokоmos / i nosokоma", "category": "επαγγέλματα" },
    { "id": "c029", "front": "ο μηχανικός / η μηχανικός", "back": "инженер / инженер (ж.)\n— одна форма для м. и ж. рода", "transliteration": "o mihanikos / i mihanikos", "category": "επαγγέλματα" },
    { "id": "c030", "front": "ο οδηγός / η οδηγός", "back": "водитель / водительница\n— одна форма", "transliteration": "o odhigos / i odhigos", "category": "επαγγέλματα" },
    { "id": "c031", "front": "ο εργάτης / η εργάτρια", "back": "рабочий / рабочая", "transliteration": "o ergatis / i ergatria", "category": "επαγγέλματα" },
    { "id": "c032", "front": "ο πωλητής / η πωλήτρια", "back": "продавец / продавщица", "transliteration": "o politis / i politria", "category": "επαγγέλματα" },
    { "id": "c033", "front": "ο αθλητής / η αθλήτρια", "back": "спортсмен / спортсменка", "transliteration": "o athlitis / i athlitria", "category": "επαγγέλματα" },

    { "id": "c034", "front": "Εγώ είμαι φοιτητής.", "back": "Я студент.\n[είμαι — 1л. ед.ч.]", "transliteration": "ego ime fotitis", "category": "είμαι" },
    { "id": "c035", "front": "Εσύ είσαι γιατρός;", "back": "Ты врач?\n[είσαι — 2л. ед.ч.]", "transliteration": "esi ise yatros", "category": "είμαι" },
    { "id": "c036", "front": "Αυτός είναι καθηγητής.", "back": "Он преподаватель.\n[είναι — 3л. ед.ч.]", "transliteration": "aftos ine kathiyitis", "category": "είμαι" },
    { "id": "c037", "front": "Αυτή είναι δασκάλα.", "back": "Она учительница.\n[είναι — 3л. ед.ч.]", "transliteration": "afti ine dhaskala", "category": "είμαι" },
    { "id": "c038", "front": "Εμείς είμαστε από την Ελλάδα.", "back": "Мы из Греции.\n[είμαστε — 1л. мн.ч.]", "transliteration": "emis imaste apo tin eladha", "category": "είμαι" },
    { "id": "c039", "front": "Εσείς είσαστε Έλληνες;", "back": "Вы греки?\n[είσαστε / είστε — 2л. мн.ч., две равнозначные формы]", "transliteration": "esis isaste elinеs", "category": "είμαι" },
    { "id": "c040", "front": "Αυτοί είναι φίλοι.", "back": "Они друзья.\n[είναι — 3л. мн.ч.]", "transliteration": "afti ine fili", "category": "είμαι" },
    { "id": "c041", "front": "Δεν είμαι από εδώ.", "back": "Я не отсюда.\n[δεν — отрицание перед глаголом]", "transliteration": "dhen ime apo edho", "category": "είμαι" },

    { "id": "c042", "front": "Εγώ μιλάω (μιλώ) ελληνικά.", "back": "Я говорю по-гречески.\n[μιλάω — 1л. ед.ч., в скобках краткая форма]", "transliteration": "ego milao elinika", "category": "μιλάω" },
    { "id": "c043", "front": "Εσύ μιλάς ρωσικά;", "back": "Ты говоришь по-русски?\n[μιλάς — 2л. ед.ч.]", "transliteration": "esi milas rosika", "category": "μιλάω" },
    { "id": "c044", "front": "Αυτός μιλάει (μιλά) αγγλικά.", "back": "Он говорит по-английски.\n[μιλάει — 3л. ед.ч., краткая форма μιλά]", "transliteration": "aftos milaei anglika", "category": "μιλάω" },
    { "id": "c045", "front": "Αυτή μιλάει πολύ καλά.", "back": "Она говорит очень хорошо.\n[μιλάει — 3л. ед.ч.]", "transliteration": "afti milaei poli kala", "category": "μιλάω" },
    { "id": "c046", "front": "Εμείς μιλάμε ελληνικά.", "back": "Мы говорим по-гречески.\n[μιλάμε — 1л. мн.ч.]", "transliteration": "emis milame elinika", "category": "μιλάω" },
    { "id": "c047", "front": "Εσείς μιλάτε αγγλικά;", "back": "Вы говорите по-английски?\n[μιλάτε — 2л. мн.ч.]", "transliteration": "esis milate anglika", "category": "μιλάω" },
    { "id": "c048", "front": "Αυτοί μιλάνε (μιλούν) ελληνικά.", "back": "Они говорят по-гречески.\n[μιλάνε — 3л. мн.ч., краткая форма μιλούν]", "transliteration": "afti milane elinika", "category": "μιλάω" },
    { "id": "c049", "front": "Δεν μιλάω καλά ελληνικά.", "back": "Я не говорю хорошо по-гречески.\n[δεν — отрицание]", "transliteration": "dhen milao kala elinika", "category": "μιλάω" },

    { "id": "c050", "front": "Πού μένεις;", "back": "Где ты живёшь?", "transliteration": "pu menis", "category": "προτάσεις" },
    { "id": "c051", "front": "Μένω στην Αθήνα.", "back": "Я живу в Афинах.\n[στην — ж.р., перед гласной ν сохраняется]", "transliteration": "meno stin athina", "category": "προτάσεις" },
    { "id": "c052", "front": "Μένω στη Μόσχα.", "back": "Я живу в Москве.\n[στη — ж.р., перед согласной ν отпадает]", "transliteration": "meno sti moscha", "category": "προτάσεις" },
    { "id": "c053", "front": "Από πού είσαι;", "back": "Откуда ты?", "transliteration": "apo pu ise", "category": "προτάσεις" },
    { "id": "c054", "front": "Είμαι από την Ελλάδα.", "back": "Я из Греции.\n[από την — вин.пад. ж.р., перед гласной]", "transliteration": "ime apo tin eladha", "category": "προτάσεις" },
    { "id": "c055", "front": "Είμαι από τη Ρωσία.", "back": "Я из России.\n[από τη — ж.р., перед согласной Ρ]", "transliteration": "ime apo ti rosia", "category": "προτάσεις" },
    { "id": "c056", "front": "Μιλάς ελληνικά;", "back": "Ты говоришь по-гречески?", "transliteration": "milas elinika", "category": "προτάσεις" },
    { "id": "c057", "front": "Ναι, μιλάω λίγο ελληνικά.", "back": "Да, я говорю немного по-гречески.", "transliteration": "ne, milao ligo elinika", "category": "προτάσεις" },
    { "id": "c058", "front": "Εσύ και εγώ μιλάμε ελληνικά.", "back": "Ты и я говорим по-гречески.", "transliteration": "esi ke ego milame elinika", "category": "προτάσεις" },
    { "id": "c059", "front": "Αυτοί είναι φοιτητές.", "back": "Они студенты.", "transliteration": "afti ine fotites", "category": "προτάσεις" },
    { "id": "c060", "front": "Βλέπω τον αδερφό μου.", "back": "Я вижу своего брата.\n[τον — вин.пад. м.р., μου = мой]", "transliteration": "vlepo ton adherfо mu", "category": "προτάσεις" },

    { "id": "c061", "front": "ο πατέρας / η μητέρα", "back": "отец / мать", "transliteration": "o pateras / i mitera", "category": "οικογένεια" },
    { "id": "c062", "front": "ο αδερφός / η αδερφή", "back": "брат / сестра", "transliteration": "o adherfos / i adherfi", "category": "οικογένεια" },
    { "id": "c063", "front": "ο γιος / η κόρη", "back": "сын / дочь", "transliteration": "o yos / i kori", "category": "οικογένεια" },
    { "id": "c064", "front": "ο άντρας / η γυναίκα", "back": "муж / жена", "transliteration": "o andras / i yineka", "category": "οικογένεια" },
    { "id": "c065", "front": "Ο αδερφός μου είναι γιατρός.", "back": "Мой брат — врач.\n[μου = мой, мой брат = ο αδερφός μου]", "transliteration": "o adherfos mu ine yatros", "category": "οικογένεια" },
    { "id": "c066", "front": "Η μητέρα μου μιλάει ελληνικά.", "back": "Моя мама говорит по-гречески.", "transliteration": "i mitera mu milaei elinika", "category": "οικογένεια" },
    { "id": "c067", "front": "Ο πατέρας μου είναι οδηγός.", "back": "Мой отец — водитель.", "transliteration": "o pateras mu ine odhigos", "category": "οικογένεια" },

    { "id": "c068", "front": "έντεκα", "back": "одиннадцать", "transliteration": "endeka", "category": "αριθμοί" },
    { "id": "c069", "front": "δώδεκα", "back": "двенадцать", "transliteration": "dhodheka", "category": "αριθμοί" },
