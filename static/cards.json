{
  "cards": [
    { "id": "c001", "front": "Εγώ", "back": "я", "transliteration": "ego", "category": "αντωνυμίες" },
    { "id": "c002", "front": "Εσύ", "back": "ты", "transliteration": "esi", "category": "αντωνυμίες" },
