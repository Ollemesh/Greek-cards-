    { "id": "c094", "front": "το αεροπλάνο", "back": "самолёт", "transliteration": "to aeroplano", "category": "μεταφορά" },
    { "id": "c095", "front": "το ταξί", "back": "такси", "transliteration": "to taksi", "category": "μεταφορά" },
    { "id": "c096", "front": "η μηχανή", "back": "мотоцикл", "transliteration": "i mihani", "category": "μεταφορά" },
    { "id": "c097", "front": "ο ηλεκτρικός", "back": "электричка (пригородная ж/д)", "transliteration": "o ilektrikos", "category": "μεταφορά" },
    { "id": "c098", "front": "με τα πόδια", "back": "пешком", "transliteration": "me ta podhia", "category": "μεταφορά" },
    { "id": "c099", "front": "η στάση", "back": "остановка", "transliteration": "i stasi", "category": "μεταφορά" },
    { "id": "c100", "front": "ο σταθμός", "back": "станция (ж/д, метро)", "transliteration": "o stathmos", "category": "μεταφορά" },
    { "id": "c101", "front": "το αεροδρόμιο", "back": "аэропорт", "transliteration": "to aerodhromio", "category": "μεταφορά" },
    { "id": "c102", "front": "το ταξιδιωτικό γραφείο", "back": "туристическое агентство", "transliteration": "to taksidhiotiko grafio", "category": "μεταφορά" },
    { "id": "c103", "front": "το εισιτήριο", "back": "билет", "transliteration": "to isitirio", "category": "μεταφορά" },
    { "id": "c104", "front": "το εισιτήριο με επιστροφή", "back": "билет туда-обратно", "transliteration": "to isitirio me epistrofi", "category": "μεταφορά" },
    { "id": "c105", "front": "το περίπτερο", "back": "киоск", "transliteration": "to periptero", "category": "μεταφορά" },

    { "id": "c106", "front": "Πού πάτε;", "back": "Куда вы едете?", "transliteration": "pu pate", "category": "μεταφορά" },
    { "id": "c107", "front": "Με συγχωρείτε, εδώ είναι η στάση;", "back": "Извините, здесь остановка?", "transliteration": "me singhorite, edho ine i stasi", "category": "μεταφορά" },
    { "id": "c108", "front": "Κάθε πότε περνάει το τρόλεϊ;", "back": "Как часто ходит троллейбус?", "transliteration": "kathe pote pernaei to troli", "category": "μεταφορά" },
    { "id": "c109", "front": "Μήπως έχετε εισιτήριο;", "back": "У вас случайно нет билета?", "transliteration": "mipos ehete isitirio", "category": "μεταφορά" },
    { "id": "c110", "front": "Πού πάει το τρόλεϊ;", "back": "Куда идёт троллейбус?", "transliteration": "pu paei to troli", "category": "μεταφορά" },
    { "id": "c111", "front": "Πόσο κάνει το εισιτήριο;", "back": "Сколько стоит билет?", "transliteration": "poso kani to isitirio", "category": "μεταφορά" },
    { "id": "c112", "front": "Το τρόλεϊ περνάει από το κέντρο;", "back": "Троллейбус проходит через центр?", "transliteration": "to troli pernaei apo to kendro", "category": "μεταφορά" },
    { "id": "c113", "front": "Πάω με το λεωφορείο.", "back": "Я еду на автобусе.\n[με + транспорт = на чём едешь: με το τρόλεϊ, με το μετρό, με τα πόδια]", "transliteration": "pao me to leoforio", "category": "μεταφορά" },

    { "id": "c114", "front": "πηγαίνω / πάω — спряжение", "back": "πηγαίνω = πάω — я иду/еду\nπηγαίνεις = πας — ты идёшь/едешь\nπηγαίνει = πάει — он/она идёт/едет\nπηγαίνουμε = πάμε — мы идём/едем\nπηγαίνετε = πάτε — вы идёте/едете\nπηγαίνουν = πάνε — они идут/едут", "transliteration": "pigeno / pao", "category": "πηγαίνω" },
    { "id": "c115", "front": "Πού πηγαίνεις; / Πού πας;", "back": "Куда ты идёшь/едешь?", "transliteration": "pu pigenis / pu pas", "category": "πηγαίνω" },
    { "id": "c116", "front": "Πηγαίνω / Πάω στο κέντρο.", "back": "Я иду/еду в центр.\n[σε + το = στο, σε + την = στην, σε + τον = στον]", "transliteration": "pigeno / pao sto kendro", "category": "πηγαίνω" },

    { "id": "c117", "front": "θέλω — спряжение", "back": "θέλω — я хочу\nθέλεις — ты хочешь\nθέλει — он/она хочет\nθέλουμε — мы хотим\nθέλετε — вы хотите\nθέλουν(ε) — они хотят", "transliteration": "thelo", "category": "θέλω" },
    { "id": "c118", "front": "Θέλω ένα εισιτήριο, παρακαλώ.", "back": "Я хочу один билет, пожалуйста.", "transliteration": "thelo ena isitirio, parakalo", "category": "θέλω" },

    { "id": "c119", "front": "περνάω / περνώ — спряжение", "back": "περνάω / περνώ — я прохожу\nπερνάς — ты проходишь\nπερνάει — он/она проходит\nπερνάμε — мы проходим\nπερνάτε — вы проходите\nπερνάν(ε) / περνούν — они проходят", "transliteration": "pernao / perno", "category": "ρήματα" },
    { "id": "c120", "front": "αργώ", "back": "опаздывать; задерживаться\n[Αργεί το λεωφορείο. = Автобус опаздывает.]", "transliteration": "arγo", "category": "ρήματα" },
    { "id": "c121", "front": "ξεκινάω / ξεκινώ", "back": "отправляться, начинать\n[Τα λεωφορεία ξεκινάνε στις 5:00. = Автобусы отправляются в 5:00.]", "transliteration": "ksekinao / ksekinо", "category": "ρήματα" },
    { "id": "c122", "front": "σταματάω / σταματώ", "back": "останавливаться\n[Το μετρό σταματάει στο αεροδρόμιο. = Метро останавливается в аэропорту.]", "transliteration": "stamatao / stamato", "category": "ρήματα" },
    { "id": "c123", "front": "φτάνω", "back": "прибывать, достигать\n[Τι ώρα φτάνει; = В котором часу прибывает?]", "transliteration": "ftano", "category": "ρήματα" },
    { "id": "c124", "front": "προτιμώ", "back": "предпочитать\n[Προτιμώ το λεωφορείο. = Я предпочитаю автобус.]", "transliteration": "protimo", "category": "ρήματα" },
    { "id": "c125", "front": "κοστίζει", "back": "стоит (о цене) = πόσο κάνει;\n[Κοστίζει 300 ευρώ. = Стоит 300 евро.]", "transliteration": "kostizi", "category": "ρήματα" },

    { "id": "c126", "front": "Τι ώρα είναι;", "back": "Который час?", "transliteration": "ti ora ine", "category": "ώρα" },
    { "id": "c127", "front": "Είναι μία ακριβώς.", "back": "Ровно час. (1:00)", "transliteration": "ine mia akrivoς", "category": "ώρα" },
    { "id": "c128", "front": "...και τέταρτο", "back": "...четверть (:15)\nπρ.: Είναι δύο και τέταρτο. = 2:15", "transliteration": "ke tetarto", "category": "ώρα" },
    { "id": "c129", "front": "...και μισή", "back": "...и половина (:30)\nπρ.: Είναι τρεις και μισή. = 3:30", "transliteration": "ke misi", "category": "ώρα" },
    { "id": "c130", "front": "...παρά τέταρτο", "back": "без четверти... (:45)\nπρ.: Είναι τέσσερις παρά τέταρτο. = 3:45", "transliteration": "para tetarto", "category": "ώρα" },
    { "id": "c131", "front": "...παρά πέντε", "back": "без пяти... (:55)\nπρ.: Είναι τρεις παρά πέντε. = 2:55", "transliteration": "para pende", "category": "ώρα" },
    { "id": "c132", "front": "πρωί", "back": "утро (5:00–12:00)", "transliteration": "proi", "category": "ώρα" },
    { "id": "c133", "front": "μεσημέρι", "back": "полдень / обеденное время (12:00–15:00)", "transliteration": "mesimeri", "category": "ώρα" },
    { "id": "c134", "front": "απόγευμα", "back": "послеполудень (15:00–19:00)", "transliteration": "apoyevma", "category": "ώρα" },
    { "id": "c135", "front": "βράδυ", "back": "вечер (19:00–24:00)", "transliteration": "vradhi", "category": "ώρα" },
    { "id": "c136", "front": "νύχτα", "back": "ночь (24:00–5:00)", "transliteration": "nihta", "category": "ώρα" },

    { "id": "c137", "front": "το πλοίο", "back": "паром, корабль", "transliteration": "to plio", "category": "μεταφορά" },
    { "id": "c138", "front": "Σε 10 λεπτά.", "back": "Через 10 минут.\n[Σε + время = через ...: Σε μία ώρα = через час]", "transliteration": "se dheka lepta", "category": "μεταφορά" },

    { "id": "c139", "front": "ξυπνάω", "back": "просыпаться\n[Ξυπνάω στις 7:00. = Просыпаюсь в 7:00.]", "transliteration": "ksipnao", "category": "ρουτίνα" },
    { "id": "c140", "front": "κοιμάμαι", "back": "спать, ложиться спать\n[Πάω για ύπνο. = Иду спать.]", "transliteration": "kiomame", "category": "ρουτίνα" },
    { "id": "c141", "front": "τρώω", "back": "есть, кушать\n[Τρώω το μεσημέρι. = Обедаю в обед.]", "transliteration": "troo", "category": "ρουτίνα" },
    { "id": "c142", "front": "βλέπω τηλεόραση", "back": "смотреть телевизор", "transliteration": "vlepo tileorasi", "category": "ρουτίνα" },
    { "id": "c143", "front": "βγαίνω (έξω)", "back": "выходить (на улицу)\n[Το βράδυ βγαίνω έξω. = Вечером выхожу на улицу.]", "transliteration": "vgeno (ekso)", "category": "ρουτίνα" },
    { "id": "c144", "front": "δουλεύω", "back": "работать\n[Δουλεύω κάθε μέρα. = Работаю каждый день.]", "transliteration": "dhulevо", "category": "ρουτίνα" },
    { "id": "c145", "front": "Πάω για ύπνο.", "back": "Иду спать.", "transliteration": "pao ya ipno", "category": "ρουτίνα" },
    { "id": "c146", "front": "Πάω βόλτα.", "back": "Иду на прогулку.\n[βόλτα = прогулка, пешая прогулка]", "transliteration": "pao volta", "category": "ρουτίνα" },
    { "id": "c147", "front": "κάθε μέρα", "back": "каждый день", "transliteration": "kathe mera", "category": "ρουτίνα" },
    { "id": "c148", "front": "κάθε πρωί / κάθε βράδυ", "back": "каждое утро / каждый вечер", "transliteration": "kathe proi / kathe vradhi", "category": "ρουτίνα" },

    { "id": "c149", "front": "Πόσο καιρό;", "back": "Как долго? / Сколько времени?\n[ο καιρός = погода ИЛИ время (в смысле срока)]", "transliteration": "poso kero", "category": "χρόνος" },
    { "id": "c150", "front": "Έναν χρόνο.", "back": "Один год.\n[ο χρόνος → έναν χρόνο — вин.пад.]", "transliteration": "enan hrono", "category": "χρόνος" },
    { "id": "c151", "front": "Δύο χρόνια.", "back": "Два года.\n[τα χρόνια — мн.ч.]", "transliteration": "dhio hronia", "category": "χρόνος" },
    { "id": "c152", "front": "Μισό χρόνο.", "back": "Полгода.\n[μισό = половина]", "transliteration": "miso hrono", "category": "χρόνος" },
    { "id": "c153", "front": "Δύο μήνες.", "back": "Два месяца.\n[ο μήνας → δύο μήνες]", "transliteration": "dhio mines", "category": "χρόνος" },
    { "id": "c154", "front": "Πολύ καιρό.", "back": "Долго. / Давно.", "transliteration": "poli kero", "category": "χρόνος" },
    { "id": "c155", "front": "Λίγο καιρό.", "back": "Недолго. / Немного времени.", "transliteration": "ligo kero", "category": "χρόνος" },

    { "id": "c156", "front": "Τι καιρό κάνει;", "back": "Какая погода?", "transliteration": "ti kero kani", "category": "καιρός" },
    { "id": "c157", "front": "Κάνει κρύο.", "back": "Холодно.", "transliteration": "kani krio", "category": "καιρός" },
    { "id": "c158", "front": "Κάνει ζέστη.", "back": "Жарко.", "transliteration": "kani zesti", "category": "καιρός" },
    { "id": "c159", "front": "Βρέχει.", "back": "Идёт дождь.", "transliteration": "vrehi", "category": "καιρός" },
    { "id": "c160", "front": "Χιονίζει.", "back": "Идёт снег.", "transliteration": "hionizi", "category": "καιρός" },
    { "id": "c161", "front": "Κάνει καλό καιρό.", "back": "Хорошая погода.", "transliteration": "kani kalo kero", "category": "καιρός" },

    { "id": "c162", "front": "Ιανουάριος", "back": "январь\n[Τον Ιανουάριο = в январе]", "transliteration": "ianouarios", "category": "μήνες" },
    { "id": "c163", "front": "Φεβρουάριος", "back": "февраль\n[Τον Φεβρουάριο = в феврале]", "transliteration": "fevruarios", "category": "μήνες" },
    { "id": "c164", "front": "Μάρτιος", "back": "март\n[Τον Μάρτιο = в марте]", "transliteration": "martios", "category": "μήνες" },
    { "id": "c165", "front": "Απρίλιος", "back": "апрель\n[Τον Απρίλιο = в апреле]", "transliteration": "aprilios", "category": "μήνες" },
    { "id": "c166", "front": "Μάιος", "back": "май\n[Τον Μάιο = в мае]", "transliteration": "maios", "category": "μήνες" },
    { "id": "c167", "front": "Ιούνιος", "back": "июнь\n[Τον Ιούνιο = в июне]", "transliteration": "iunios", "category": "μήνες" },
    { "id": "c168", "front": "Ιούλιος", "back": "июль\n[Τον Ιούλιο = в июле]", "transliteration": "iulios", "category": "μήνες" },
    { "id": "c169", "front": "Αύγουστος", "back": "август\n[Τον Αύγουστο = в августе]", "transliteration": "avgoustos", "category": "μήνες" },
    { "id": "c170", "front": "Σεπτέμβριος", "back": "сентябрь\n[Τον Σεπτέμβριο = в сентябре]", "transliteration": "septemvrios", "category": "μήνες" },
    { "id": "c171", "front": "Οκτώβριος", "back": "октябрь\n[Τον Οκτώβριο = в октябре]", "transliteration": "oktovrios", "category": "μήνες" },
    { "id": "c172", "front": "Νοέμβριος", "back": "ноябрь\n[Τον Νοέμβριο = в ноябре]", "transliteration": "noemvrios", "category": "μήνες" },
    { "id": "c173", "front": "Δεκέμβριος", "back": "декабрь\n[Τον Δεκέμβριο = в декабре]", "transliteration": "dhekemvrios", "category": "μήνες" },

    { "id": "c174", "front": "ο χειμώνας", "back": "зима\n[Τον χειμώνα = зимой]", "transliteration": "o himonas", "category": "εποχές" },
    { "id": "c175", "front": "η άνοιξη", "back": "весна\n[Την άνοιξη = весной]", "transliteration": "i anoksi", "category": "εποχές" },
    { "id": "c176", "front": "το καλοκαίρι", "back": "лето\n[Το καλοκαίρι = летом]", "transliteration": "to kalokeri", "category": "εποχές" },
    { "id": "c177", "front": "το φθινόπωρο", "back": "осень\n[Το φθινόπωρο = осенью]", "transliteration": "to fthinoporo", "category": "εποχές" },

    { "id": "c178", "front": "η Δευτέρα", "back": "понедельник\n[Τη Δευτέρα = в понедельник]", "transliteration": "i dheftera", "category": "μέρες" },
    { "id": "c179", "front": "η Τρίτη", "back": "вторник\n[Τη Τρίτη = во вторник]", "transliteration": "i triti", "category": "μέρες" },
    { "id": "c180", "front": "η Τετάρτη", "back": "среда\n[Τη Τετάρτη = в среду]", "transliteration": "i tetarti", "category": "μέρες" },
    { "id": "c181", "front": "η Πέμπτη", "back": "четверг\n[Τη Πέμπτη = в четверг]", "transliteration": "i pempti", "category": "μέρες" },
    { "id": "c182", "front": "η Παρασκευή", "back": "пятница\n[Τη Παρασκευή = в пятницу]", "transliteration": "i paraskevi", "category": "μέρες" },
    { "id": "c183", "front": "το Σάββατο", "back": "суббота\n[Το Σάββατο = в субботу]", "transliteration": "to savato", "category": "μέρες" },
    { "id": "c184", "front": "η Κυριακή", "back": "воскресенье\n[Την Κυριακή = в воскресенье]", "transliteration": "i kiriaki", "category": "μέρες" },

    { "id": "c185", "front": "πάντα", "back": "всегда", "transliteration": "panda", "category": "επιρρήματα" },
    { "id": "c186", "front": "συνήθως", "back": "обычно, как правило", "transliteration": "sinithos", "category": "επιρρήματα" },
    { "id": "c187", "front": "συχνά", "back": "часто", "transliteration": "sihna", "category": "επιρρήματα" },
    { "id": "c188", "front": "μερικές φορές", "back": "иногда, время от времени", "transliteration": "merikes fores", "category": "επιρρήματα" },
    { "id": "c189", "front": "σπάνια", "back": "редко", "transliteration": "spania", "category": "επιρρήματα" },
    { "id": "c190", "front": "ποτέ (+ δεν)", "back": "никогда\n[Ποτέ δεν πάω. = Я никогда не хожу.\nδεν + глагол + ποτέ — отрицание]", "transliteration": "pote", "category": "επιρρήματα" },
    { "id": "c191", "front": "καθόλου", "back": "совсем не, нисколько\n[Δεν μου αρέσει καθόλου. = Мне совсем не нравится.]", "transliteration": "katholou", "category": "επιρρήματα" },
    { "id": "c192", "front": "Πόσο συχνά;", "back": "Как часто?", "transliteration": "poso sihna", "category": "επιρρήματα" },

    { "id": "c193", "front": "νωρίς", "back": "рано\n[Ξυπνάω νωρίς. = Просыпаюсь рано.]", "transliteration": "noris", "category": "επιρρήματα" },
    { "id": "c194", "front": "αργά", "back": "поздно; медленно\n[Πάω για ύπνο αργά. = Ложусь спать поздно.]", "transliteration": "arga", "category": "επιρρήματα" },

    { "id": "c195", "front": "σήμερα", "back": "сегодня", "transliteration": "simera", "category": "χρόνος" },
    { "id": "c196", "front": "αύριο", "back": "завтра", "transliteration": "avrio", "category": "χρόνος" },
    { "id": "c197", "front": "χθες", "back": "вчера", "transliteration": "hthes", "category": "χρόνος" },
    { "id": "c198", "front": "μεθαύριο", "back": "послезавтра", "transliteration": "methavrio", "category": "χρόνος" },

    { "id": "c199", "front": "Τι λες, πάμε για καφέ;", "back": "Что скажешь, пойдём на кофе?\n[Πάμε για... = пойдём на/за...]", "transliteration": "ti les, pame ya kafe", "category": "πρόσκληση" },
    { "id": "c200", "front": "Αύριο τι κάνεις;", "back": "Завтра что делаешь? (ты свободен?)", "transliteration": "avrio ti kanis", "category": "πρόσκληση" },
    { "id": "c201", "front": "Είμαι ελεύθερος / ελεύθερη.", "back": "Я свободен / свободна.\n[ελεύθερος — м.р., ελεύθερη — ж.р.]", "transliteration": "ime eleftheros / eleftheri", "category": "πρόσκληση" },
    { "id": "c202", "front": "Ναι, γιατί όχι;", "back": "Да, почему нет?", "transliteration": "ne, yati ohi", "category": "πρόσκληση" },
    { "id": "c203", "front": "Ναι, αμέ!", "back": "Ну конечно! / Само собой!\n[разговорное, очень греческое выражение]", "transliteration": "ne, ame", "category": "πρόσκληση" },

    { "id": "c204", "front": "ακούω — спряжение", "back": "ακούω — я слушаю\nακούς — ты слушаешь\nακούει — он/она слушает\nακούμε — мы слушаем\nακούτε — вы слушаете\nακούν(ε) — они слушают", "transliteration": "akuo", "category": "ακούω" },
    { "id": "c205", "front": "Ακούω μουσική.", "back": "Слушаю музыку.", "transliteration": "akuo mousiki", "category": "ακούω" },

    { "id": "c206", "front": "διαβάζω", "back": "читаю\n[Διαβάζω εφημερίδα. = Читаю газету.]", "transliteration": "dhiavazo", "category": "ρουτίνα" },
    { "id": "c207", "front": "πίνω", "back": "пью\n[Πίνω καφέ. = Пью кофе.]", "transliteration": "pino", "category": "ρουτίνα" },
    { "id": "c208", "front": "κάνω γυμναστική", "back": "заниматься гимнастикой, фитнесом", "transliteration": "kano yimnastiki", "category": "ρουτίνα" },
    { "id": "c209", "front": "καπνίζω", "back": "курить\n[Δεν καπνίζω. = Я не курю.]", "transliteration": "kapnizo", "category": "ρουτίνα" },

    { "id": "c210", "front": "η εφημερίδα", "back": "газета", "transliteration": "i efimerida", "category": "ρουτίνα" },
    { "id": "c211", "front": "η μουσική", "back": "музыка", "transliteration": "i mousiki", "category": "ρουτίνα" },

    { "id": "c212", "front": "Με λένε... / Ονομάζομαι...", "back": "Меня зовут...\n[Με λένε Ολέκ. = Меня зовут Олег.\nОбе формы равнозначны.]", "transliteration": "me lene... / onomazome...", "category": "εισαγωγή" },
    { "id": "c213", "front": "Πώς σε λένε; / Πώς ονομάζεσαι;", "back": "Как тебя зовут?", "transliteration": "pos se lene / pos onomazese", "category": "εισαγωγή" },
    { "id": "c214", "front": "Ποιο είναι το όνομά σου;", "back": "Какое твоё имя?\n[ποιο = какое (ср.р.)]", "transliteration": "pio ine to onoma su", "category": "εισαγωγή" },
    { "id": "c215", "front": "Ποιο είναι το επώνυμό σου;", "back": "Какова твоя фамилия?\n[το επώνυμο = фамилия]", "transliteration": "pio ine to eponimo su", "category": "εισαγωγή" },
    { "id": "c216", "front": "Ποιο είναι το τηλέφωνό σου;", "back": "Какой твой номер телефона?", "transliteration": "pio ine to tilefono su", "category": "εισαγωγή" },
    { "id": "c217", "front": "Ποια είναι η διεύθυνσή σου;", "back": "Какой твой адрес?\n[η διεύθυνση = адрес; ποια = какая (ж.р.)]", "transliteration": "pia ine i dhiefthinsi su", "category": "εισαγωγή" },
    { "id": "c218", "front": "Σε ποια πόλη μένεις;", "back": "В каком городе живёшь?\n[η πόλη = город]", "transliteration": "se pia poli menis", "category": "εισαγωγή" },

    { "id": "c219", "front": "ο προγραμματιστής / η προγραμματίστρια", "back": "программист / программистка", "transliteration": "o programatistis / i programatistria", "category": "επαγγέλματα" },
    { "id": "c220", "front": "η εταιρεία", "back": "компания, фирма\n[η εταιρεία υπολογιστών = IT-компания]", "transliteration": "i eteria", "category": "επαγγέλματα" },
    { "id": "c221", "front": "η πληροφορική", "back": "информатика, IT", "transliteration": "i pliroforiki", "category": "επαγγέλματα" },
    { "id": "c222", "front": "το διαδίκτυο", "back": "интернет", "transliteration": "to dhiadhiktio", "category": "επαγγέλματα" },

    { "id": "c223", "front": "έχω — спряжение", "back": "έχω — у меня есть / я имею\nέχεις — у тебя есть\nέχει — у него/неё есть\nέχουμε — у нас есть\nέχετε — у вас есть\nέχουν(ε) — у них есть", "transliteration": "eho", "category": "έχω" },
    { "id": "c224", "front": "Έχω ένα παιδί. / Έχω έναν γιο.", "back": "У меня есть ребёнок. / У меня есть сын.\n[έναν — вин.пад. м.р., ένα — вин.пад. ср.р.]", "transliteration": "eho ena pedhi / eho enan yo", "category": "έχω" },
    { "id": "c225", "front": "Τι δουλειά κάνεις;", "back": "Чем занимаешься? / Какая у тебя работа?", "transliteration": "ti dhulia kanis", "category": "έχω" },
    { "id": "c226", "front": "Πού δουλεύεις; / Δουλεύω σε εταιρεία.", "back": "Где работаешь? / Работаю в компании.\n[σε εταιρεία = в компании (без артикля после σε)]", "transliteration": "pu dhulevoo / dhulevо se eteria", "category": "έχω" },

    { "id": "c227", "front": "γράφω", "back": "писать\n[Γράφω γράμμα. = Пишу письмо.]", "transliteration": "grafo", "category": "ρήματα" },
    { "id": "c228", "front": "μαγειρεύω", "back": "готовить (еду)\n[Μαγειρεύω κάθε μέρα. = Готовлю каждый день.]", "transliteration": "mayirevo", "category": "ρήματα" },
    { "id": "c229", "front": "καθαρίζω", "back": "убирать, чистить\n[Καθαρίζω το σπίτι. = Убираю дом.]", "transliteration": "katharizo", "category": "ρήματα" },
    { "id": "c230", "front": "αγαπάω / αγαπώ", "back": "любить\n[Αγαπώ την οικογένειά μου. = Люблю свою семью.]", "transliteration": "agapao / agapo", "category": "ρήματα" },
    { "id": "c231", "front": "περπατάω / περπατώ", "back": "ходить пешком, гулять\n[Περπατάω κάθε πρωί. = Гуляю каждое утро.]", "transliteration": "perpatao / perpato", "category": "ρήματα" },
    { "id": "c232", "front": "τηλεφωνάω / τηλεφωνώ", "back": "звонить по телефону\n[Τηλεφωνώ στη μητέρα μου. = Звоню маме.]", "transliteration": "tilefonao / tilefono", "category": "ρήματα" },
    { "id": "c233", "front": "ρωτάω / ρωτώ", "back": "спрашивать\n[Ρωτάω τον δάσκαλο. = Спрашиваю учителя.]", "transliteration": "rotao / roto", "category": "ρήματα" },
    { "id": "c234", "front": "απαντάω / απαντώ", "back": "отвечать\n[Απαντάω στην ερώτηση. = Отвечаю на вопрос.]", "transliteration": "apandao / apando", "category": "ρήματα" },
    { "id": "c235", "front": "πεινάω / πεινώ", "back": "быть голодным, хотеть есть\n[Πεινάω πολύ. = Я очень голоден/голодна.]", "transliteration": "pinao / pino", "category": "ρήματα" },
    { "id": "c236", "front": "διψάω / διψώ", "back": "хотеть пить, испытывать жажду\n[Διψάω. = Я хочу пить.]", "transliteration": "dhipsao / dhipso", "category": "ρήματα" },
    { "id": "c237", "front": "καταλαβαίνω", "back": "понимать\n[Καταλαβαίνεις; = Ты понимаешь?]", "transliteration": "katalaveno", "category": "ρήματα" },
    { "id": "c238", "front": "μαθαίνω", "back": "учиться, изучать\n[Μαθαίνω ελληνικά. = Учу греческий.]", "transliteration": "matheno", "category": "ρήματα" },
    { "id": "c239", "front": "ταξιδεύω", "back": "путешествовать\n[Ταξιδεύω πολύ. = Я много путешествую.]", "transliteration": "taksidhevo", "category": "ρήματα" },

    { "id": "c240", "front": "ο κινηματογράφος", "back": "кинотеатр\n[Πάω στον κινηματογράφο. = Иду в кино.]", "transliteration": "o kinimatografos", "category": "τόποι" },
    { "id": "c241", "front": "το πάρκο", "back": "парк\n[Πάω στο πάρκο. = Иду в парк.]", "transliteration": "to parko", "category": "τόποι" },
    { "id": "c242", "front": "το γυμναστήριο", "back": "спортзал\n[Πάω γυμναστήριο. = Хожу в спортзал.]", "transliteration": "to yimnastirio", "category": "τόποι" },

    { "id": "c243", "front": "Τι γλώσσες μιλάς;", "back": "Какие языки ты говоришь?", "transliteration": "ti glosses milas", "category": "γλώσσες" },
    { "id": "c244", "front": "ξένες γλώσσες", "back": "иностранные языки", "transliteration": "ksenes glosses", "category": "γλώσσες" },
    { "id": "c245", "front": "Τώρα μαθαίνω ελληνικά.", "back": "Сейчас учу греческий.", "transliteration": "tora matheno elinika", "category": "γλώσσες" },

    { "id": "c246", "front": "με κάρτα / με μετρητά", "back": "картой / наличными\n[Πληρώνω με κάρτα. = Плачу картой.]", "transliteration": "me karta / me metrita", "category": "πληρωμή" },

    { "id": "c247", "front": "τρώω πρωινό", "back": "завтракаю\n[πρωινό = завтрак (≠ πρωί = утро)]", "transliteration": "troo proino", "category": "ρουτίνα" },
    { "id": "c248", "front": "μεσημεριανό", "back": "обед (еда)\n[τρώω μεσημεριανό = обедаю]", "transliteration": "mesimerianos", "category": "ρουτίνα" },

    { "id": "c249", "front": "η βαλίτσα", "back": "чемодан", "transliteration": "i valitsa", "category": "μεταφορά" },
    { "id": "c250", "front": "το παγωτό", "back": "мороженое\n[Θέλω ένα παγωτό. = Хочу одно мороженое.]", "transliteration": "to pagoto", "category": "φαγητό" },
    { "id": "c251", "front": "η σοκολάτα", "back": "шоколад\n[Θέλω μια σοκολάτα. = Хочу шоколадку.]", "transliteration": "i sokolata", "category": "φαγητό" },

    { "id": "c252", "front": "τα γενέθλια", "back": "день рождения\n[Χρόνια πολλά! = Поздравляю! (букв. многих лет)]", "transliteration": "ta yenethlia", "category": "λέξεις" },
    { "id": "c253", "front": "Πότε είναι τα γενέθλιά σου;", "back": "Когда твой день рождения?", "transliteration": "pote ine ta yenethlia su", "category": "λέξεις" },
    { "id": "c254", "front": "...χρονών", "back": "...лет (возраст)\n[Είμαι 30 χρονών. = Мне 30 лет.]", "transliteration": "hronon", "category": "λέξεις" },

    { "id": "c255", "front": "κάνω κολύμπι", "back": "плавать\n[= κολυμπάω]", "transliteration": "kano kolibi", "category": "σπορ" },
    { "id": "c256", "front": "κάνω ποδηλασία", "back": "кататься на велосипеде\n[το ποδήλατο = велосипед]", "transliteration": "kano podhilasia", "category": "σπορ" },

    { "id": "c257", "front": "Συγγνώμη που άργησα.", "back": "Извини, что опоздал/опоздала.\n[συγγνώμη = извини/простите]", "transliteration": "signomi pu argisa", "category": "λέξεις" },
    { "id": "c258", "front": "Κανένα πρόβλημα.", "back": "Никаких проблем. / Всё нормально.", "transliteration": "kanena provlima", "category": "λέξεις" }
  ]
}
