    { "id": "c080", "front": "πενήντα (50)", "back": "пятьдесят", "transliteration": "peninda", "category": "αριθμοί" },
    { "id": "c081", "front": "εξήντα (60)", "back": "шестьдесят", "transliteration": "eksinda", "category": "αριθμοί" },
