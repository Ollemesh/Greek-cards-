    { "id": "c077", "front": "είκοσι", "back": "двадцать", "transliteration": "ikosi", "category": "αριθμοί" },
    { "id": "c078", "front": "τριάντα", "back": "тридцать", "transliteration": "trianda", "category": "αριθμοί" },
    { "id": "c079", "front": "σαράντα", "back": "сорок", "transliteration": "saranda", "category": "αριθμοί" },
    { "id": "c080", "front": "πενήντα", "back": "пятьдесят", "transliteration": "peninda", "category": "αριθμοί" },
    { "id": "c081", "front": "εξήντα", "back": "шестьдесят", "transliteration": "eksinda", "category": "αριθμοί" },
    { "id": "c082", "front": "εβδομήντα", "back": "семьдесят", "transliteration": "evdhominda", "category": "αριθμοί" },
    { "id": "c083", "front": "ογδόντα", "back": "восемьдесят", "transliteration": "ogdhonda", "category": "αριθμοί" },
    { "id": "c084", "front": "ενενήντα", "back": "девяносто", "transliteration": "eneninda", "category": "αριθμοί" },
    { "id": "c085", "front": "εκατό", "back": "сто", "transliteration": "ekato", "category": "αριθμοί" },
